CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# A freshly OTA'd image boots PENDING_VERIFY; app_main marks it valid once Wi-Fi
# is up, otherwise the bootloader rolls back to the previous slot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200
# app_main runs the clock loop (float snprintf, face state, render callbacks)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# The settings page allows a 32 character hostname and the DHCP request carries it
# twice; the 69 byte default fits 14, so a longer name associates and then never
# leases. 128 covers the maximum with room for the other options.
CONFIG_LWIP_DHCP_OPTIONS_LEN=128
